# PostgreSQL. Obrigatório. O schema catalog_sync é criado na primeira execução.
# Para popular fabricante/modelo/referência/tamanho do app, use o mesmo banco da implante-flow-api.
DATABASE_URL=postgres://implante:implante@127.0.0.1:5432/implante_flow

# error | warn | info | debug | silent
LOG_LEVEL=info

# Fontes separadas por vírgula. Vazio roda todas: anvisa, neodent, straumann, nobel, sin, implacil, geistlich.
SYNC_SOURCES=

# Intervalo mínimo entre sincronizações bem-sucedidas, por fonte, em horas.
# Padrões: anvisa 24h; catálogos de fabricante 168h (7 dias).
# O cron do Railway acorda a cada hora; uma fonte só roda quando o intervalo venceu.
SYNC_INTERVAL_HOURS_ANVISA=24
SYNC_INTERVAL_HOURS_NEODENT=168

# Fração máxima de itens publicados que pode sumir da fonte numa execução. Acima disso a publicação é bloqueada.
SYNC_MAX_DROP_RATIO=0.2

# Validade do lock por fonte. Um processo que morrer libera a fonte quando o lock expira.
SYNC_LOCK_LEASE_MINUTES=60

# Documentos maiores que este limite guardam só metadados (checksum, ETag, URL), sem o payload gzip.
SYNC_RETAIN_PAYLOAD_MAX_BYTES=31457280

# Limites de download (PDFs de catálogo passam de 100 MB).
HTTP_TIMEOUT_MS=120000
HTTP_MAX_BYTES=209715200
HTTP_ATTEMPTS=3
