# PostgreSQL. Obrigatório. As tabelas ficam no schema catalog_sync, que é criado na primeira execução.
DATABASE_URL=postgres://sync:sync@127.0.0.1:55432/catalog

# error | warn | info | debug | silent
LOG_LEVEL=info

# Fontes separadas por vírgula. Vazio roda todas as registradas (hoje: anvisa).
SYNC_SOURCES=

# Intervalo mínimo entre sincronizações bem-sucedidas, por fonte, em horas. Padrão definido pela fonte (anvisa: 24).
# O cron do Railway acorda a cada hora; uma fonte só roda quando o intervalo venceu, e falhas são repetidas no ciclo seguinte.
SYNC_INTERVAL_HOURS_ANVISA=24

# Fração máxima de itens publicados que pode sumir da fonte numa execução. Acima disso a publicação é bloqueada.
SYNC_MAX_DROP_RATIO=0.2

# Validade do lock por fonte. Um processo que morrer libera a fonte quando o lock expira.
SYNC_LOCK_LEASE_MINUTES=60

# Limites de download.
HTTP_TIMEOUT_MS=120000
HTTP_MAX_BYTES=104857600
HTTP_ATTEMPTS=3
